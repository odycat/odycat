# Copyright (c) 2026 Ocean Octane S.L.U.
# OdyCAT engine as a service: one instance per config in /etc/odycat/,
#   systemctl start odycat@machine      ->  /etc/odycat/machine.json
# Installed by `sudo make -C engine install-service` (@BINDIR@ is filled in).
# It runs as the system user `odycat` with only the two capabilities
# real-time needs, in a sandbox; members of the `odycat` group can start and
# stop it (polkit rule) and attach their scripts to /run/odycat.

[Unit]
Description=OdyCAT EtherCAT engine (%i)
Documentation=https://odycat.org
After=ethercat.service

[Service]
Type=simple
User=odycat
Group=odycat
ExecStart=@BINDIR@/odycat /etc/odycat/%i.json
Restart=on-failure
RestartSec=2

# Real time without root: SCHED_FIFO and locked memory, nothing else.
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK
LimitMEMLOCK=infinity

# Run directory for the shared memory and the instance lock: /run/odycat,
# mode 0750, owner odycat, removed when the service stops.
RuntimeDirectory=odycat
RuntimeDirectoryMode=0750
Environment=ODYCAT_RUN_DIR=/run/odycat

# The EtherCAT master devices and nothing else.
DevicePolicy=closed
DeviceAllow=char-EtherCAT rw

# Sandbox: the engine reads its config, uses the master device and writes
# its run directory; it opens no network sockets.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# The CPU of the real-time loop goes in a drop-in, e.g.
# /etc/systemd/system/odycat@.service.d/cpu.conf with CPUAffinity=7
# (see docs/realtime.md).

[Install]
WantedBy=multi-user.target
